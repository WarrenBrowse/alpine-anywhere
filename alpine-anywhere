#!/bin/sh
#
# alpine-anywhere - Boot any Linux server into Alpine Linux RAM-only mode
#
# Similar to nixos-anywhere, this tool uses kexec to boot a remote server
# into Alpine Linux running entirely in RAM, without touching the disk.
#
# Usage: alpine-anywhere [OPTIONS] <user@host>
#
# Copyright (c) 2024
# License: MIT
#

set -eu

# =============================================================================
# Script Initialization
# =============================================================================

# Get the directory where the script is located
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Determine library directory
LIB_DIR="${SCRIPT_DIR}/lib"
if [ ! -d "$LIB_DIR" ]; then
    echo "ERROR: Cannot find library directory: $LIB_DIR" >&2
    exit 1
fi

# Source all library files
. "${LIB_DIR}/common.sh"
. "${LIB_DIR}/ssh.sh"
. "${LIB_DIR}/exec.sh"
. "${LIB_DIR}/network.sh"
. "${LIB_DIR}/download.sh"
. "${LIB_DIR}/apkovl.sh"
. "${LIB_DIR}/kexec.sh"
. "${LIB_DIR}/validate.sh"
. "${LIB_DIR}/remote.sh"
. "${LIB_DIR}/takeover.sh"
. "${LIB_DIR}/pivot.sh"
. "${LIB_DIR}/install.sh"
. "${LIB_DIR}/init_s6.sh"
. "${LIB_DIR}/upgrade.sh"
. "${LIB_DIR}/hardening.sh"

# =============================================================================
# Banner
# =============================================================================

print_banner() {
    if [ "$VERBOSE" = "true" ]; then
        cat <<'EOF'
       _       _                                    _
  __ _| |_ __ (_)_ __   ___        __ _ _ __  _   _| |__   ___ _ __ ___
 / _` | | '_ \| | '_ \ / _ \_____ / _` | '_ \| | | | '_ \ / _ \ '__/ _ \
| (_| | | |_) | | | | |  __/_____| (_| | | | | |_| | | | |  __/ | |  __/
 \__,_|_| .__/|_|_| |_|\___|      \__,_|_| |_|\__, |_| |_|\___|_|  \___|
        |_|                                   |___/

EOF
    fi
    local mode_desc="Live mode (RAM-only, revert on reboot)"
    if [ "$INSTALL_MODE" = "true" ]; then
        mode_desc="Install mode (immutable A/B, persistent)"
    elif [ "$UPGRADE_MODE" = "true" ]; then
        mode_desc="Upgrade mode (atomic A/B switch)"
    fi
    echo "alpine-anywhere v2.0.0 - Immutable Alpine Linux with A/B updates"
    echo "Mode: $mode_desc"
    echo ""
}

# =============================================================================
# Main Flow
# =============================================================================

main() {
    # Parse command line arguments
    parse_arguments "$@"

    # Lightweight A/B slot subcommands (status/verify/rollback/bootcount).
    # Handled before the banner/work-dir setup so they stay quiet and fast
    # (bootcount runs at every boot from an OpenRC service).
    if [ -n "$SLOT_ACTION" ]; then
        run_slot_action
        exit $?
    fi

    # Print banner
    print_banner

    # Setup cleanup trap
    setup_cleanup_trap

    # Create working directory
    create_work_dir

    # Show dry-run notice
    if [ "$DRY_RUN" = "true" ]; then
        log_warn "DRY-RUN MODE - No changes will be made"
        echo ""
    fi

    # Handle different modes
    if [ "$UPGRADE_MODE" = "true" ]; then
        # Upgrade mode
        if [ "$LOCAL_MODE" = "true" ]; then
            run_local_upgrade
        else
            run_remote_upgrade
        fi
    elif [ "$INSTALL_CONTINUE" = "true" ]; then
        # Continue A/B installation after pivot (runs in pivoted environment)
        run_install_continue
    elif [ "$INSTALL_MODE" = "true" ]; then
        # Install mode (A/B immutable)
        if [ "$LOCAL_MODE" = "true" ]; then
            run_local_ab_install
        else
            run_remote_ab_install
        fi
    else
        # Live mode (default)
        if [ "$LOCAL_MODE" = "true" ]; then
            run_local_installation
        else
            run_remote_installation
        fi
    fi
}

# =============================================================================
# A/B slot subcommands (status / verify / rollback / bootcount)
# =============================================================================

run_slot_action() {
    # Remote target given -> run the subcommand on the device over SSH.
    if [ -n "$TARGET_HOST" ] && [ "$TARGET_HOST" != "localhost" ] && [ "$LOCAL_MODE" != "true" ]; then
        setup_ssh_multiplexing
        test_ssh_connection
        run_on_remote "$SLOT_ACTION"
        return $?
    fi

    # Local: operate on this installed device.
    case "$SLOT_ACTION" in
        status)    show_status ;;
        verify)    verify_current_slot ;;
        rollback)  rollback_slot ;;
        bootcount) increment_boot_counter ;;
        *)         die "Unknown slot action: $SLOT_ACTION" ;;
    esac
}

# =============================================================================
# Remote Mode: Deploy scripts and execute on remote
# =============================================================================

run_remote_installation() {
    # Enable SSH multiplexing for connection reuse
    setup_ssh_multiplexing

    # Step 1: Local validations
    log_step "Step 1/4: Local validation"
    validate_local_commands

    # Step 2: Test SSH connection
    log_step "Step 2/4: SSH connection"
    test_ssh_connection

    # Step 3: Check root access
    log_step "Step 3/4: Root access verification"
    check_root_access

    # Step 4: Deploy and pivot
    log_step "Step 4/4: Deploying to remote"
    deploy_scripts_to_remote

    log_info "Scripts deployed. Pivoting to Alpine (RAM-only)..."
    echo ""

    # Execute on remote - connection will be lost during pivot
    run_on_remote || true

    echo ""
    echo "============================================"
    echo "  Alpine Linux is running from RAM!"
    echo "============================================"
    echo ""
    echo "  Connect: ssh root@${TARGET_HOST}"
    echo "  Reboot:  restores original system"
    echo ""
}

# =============================================================================
# Remote Mode: A/B Install
# =============================================================================

run_remote_ab_install() {
    setup_ssh_multiplexing

    log_step "Step 1/4: Local validation"
    validate_local_commands

    log_step "Step 2/4: SSH connection"
    test_ssh_connection

    log_step "Step 3/4: Root access verification"
    check_root_access

    log_step "Step 4/4: Deploying to remote"
    deploy_scripts_to_remote

    log_info "Scripts deployed. Running A/B installation on remote..."
    echo ""

    # Pass --install flag to remote
    run_on_remote "--install"

    show_install_completion_message
}

# =============================================================================
# Remote Mode: Upgrade
# =============================================================================

run_remote_upgrade() {
    setup_ssh_multiplexing

    log_step "Step 1/3: SSH connection"
    test_ssh_connection

    log_step "Step 2/3: Root access verification"
    check_root_access

    log_step "Step 3/3: Running upgrade on remote"
    run_on_remote "upgrade"

    show_upgrade_completion_message
}

# =============================================================================
# Local Mode: A/B Install
# =============================================================================

run_local_ab_install() {
    # Require root for A/B installation
    if [ "$(id -u)" -ne 0 ]; then
        log_info "Escalating to root for A/B installation..."
        sudo_args="--local --install"
        [ "$VERBOSE" = "true" ] && sudo_args="$sudo_args -v"
        [ "$FORCE" = "true" ] && sudo_args="$sudo_args -f"
        [ "$DRY_RUN" = "true" ] && sudo_args="$sudo_args -n"
        [ -n "$ALPINE_VERSION" ] && sudo_args="$sudo_args -V $ALPINE_VERSION"
        [ -n "$ALPINE_MIRROR" ] && sudo_args="$sudo_args -m $ALPINE_MIRROR"
        [ -n "$KERNEL_FLAVOR" ] && sudo_args="$sudo_args -k $KERNEL_FLAVOR"
        [ "$HARDENED_MODE" = "true" ] && sudo_args="$sudo_args --hardened"
        [ -n "$OVERLAY_DEVICE" ] && sudo_args="$sudo_args --overlay=$OVERLAY_DEVICE"
        [ -n "$EXTRA_PACKAGES" ] && sudo_args="$sudo_args --extra-packages=$EXTRA_PACKAGES"
        [ -n "$CUSTOM_SCRIPT" ] && sudo_args="$sudo_args --custom-script=$CUSTOM_SCRIPT"
        [ -n "$SSH_HOST_KEY_DIR" ] && sudo_args="$sudo_args --ssh-host-keys=$SSH_HOST_KEY_DIR"
        [ -n "$TARGET_DISK" ] && sudo_args="$sudo_args --disk=$TARGET_DISK"
        [ -n "$INIT_SYSTEM" ] && sudo_args="$sudo_args --init=$INIT_SYSTEM"
        exec sudo -E sh "$0" $sudo_args
    fi

    log_info "Running A/B installation in local mode"

    # Setup directories
    setup_install_dirs "$HOME"
    create_install_dirs

    # Step 1: Validations
    log_step "Step 1/6: System validation"
    validate_local_commands
    validate_local_system

    # Step 2: Network detection
    log_step "Step 2/6: Network detection"
    detect_local_network
    print_network_summary

    # Step 3: SSH keys
    log_step "Step 3/6: SSH key retrieval"
    local ssh_keys
    ssh_keys=$(get_local_authorized_keys)

    # Step 4: Generate config
    log_step "Step 4/6: Configuration generation"
    find_working_mirror_local
    local apkovl_file
    apkovl_file=$(generate_apkovl "$ssh_keys")

    # Step 5: Download files
    log_step "Step 5/6: Downloading Alpine files"
    download_minirootfs

    # Preserve the existing server's SSH host identity (unless explicitly
    # provided). Captured now, before the disk is wiped; staged into the
    # installer by generate_pivot_init.
    if [ -z "$SSH_HOST_KEY_DIR" ]; then
        if capture_host_identity /tmp/aa-captured-keys; then
            SSH_HOST_KEY_DIR=/tmp/aa-captured-keys
        fi
    fi

    # If the target disk is NOT the disk we're booted from, no pivot is needed:
    # partition + install directly (e.g. a Debian/Armbian SD installing onto an
    # attached USB/SSD). The pivot only exists to free the disk you run from.
    local root_disk=""
    root_disk=$(strip_partition "$(findmnt -n -o SOURCE / 2>/dev/null)" 2>/dev/null)
    if [ -n "$TARGET_DISK" ] && [ -n "$root_disk" ] && [ "$TARGET_DISK" != "$root_disk" ]; then
        log_info "Target $TARGET_DISK differs from boot disk $root_disk -> installing without pivot"
        run_ab_install
        show_install_completion_message
        return 0
    fi

    # Step 6: Pivot to Alpine
    log_step "Step 6/6: Pivot to Alpine environment"

    # Setup pivot environment and execute pivot
    # The pivot script will continue the installation from within Alpine
    setup_pivot_environment
    execute_pivot

    # If we get here, the pivot is running in background
    # The actual installation will continue from do_pivot.sh
    log_info "Pivot initiated. Installation will continue in the new environment."
    log_info "The connection will be lost. Reconnect via: ssh root@${DETECTED_IP_ADDRESS}"
    log_info "Monitor installation: tail -f /var/log/alpine-install.log"
}

# =============================================================================
# Install Continue Mode (after pivot)
# =============================================================================

run_install_continue() {
    log_info "Continuing A/B installation after pivot..."

    # We're running in the pivoted Alpine environment
    # The old root should be unmounted, so we can partition the disk

    # Load config from pivot
    if [ -f /etc/alpine-anywhere/config.env ]; then
        . /etc/alpine-anywhere/config.env
        log_info "Config loaded from pivot environment"
    fi

    # Setup directories
    INSTALL_BASE_DIR="/root/.local/share/alpine-anywhere"
    INSTALL_CACHE_DIR="${INSTALL_BASE_DIR}/cache"
    mkdir -p "$INSTALL_CACHE_DIR"

    # Detect disk (explicit --disk wins, consistent with run_ab_install)
    local disk
    if [ -n "$TARGET_DISK" ]; then
        disk="$TARGET_DISK"
    else
        disk=$(detect_root_disk)
    fi
    log_info "Target disk: $disk"

    # Check disk is unmounted
    if mount | grep -q "^${disk}"; then
        log_warn "Disk $disk has mounted partitions, attempting to unmount..."
        for part in $(mount | grep "^${disk}" | awk '{print $3}' | sort -r); do
            umount -l "$part" 2>/dev/null || true
        done
        sleep 2
    fi

    # Run the actual installation
    run_ab_install

    show_install_completion_message
}

# =============================================================================
# Local Mode: Upgrade
# =============================================================================

run_local_upgrade() {
    log_info "Running upgrade in local mode"

    # Setup directories
    setup_install_dirs "$HOME"

    # Check we're running on an A/B installed system (immutable squashfs root)
    if ! mount 2>/dev/null | grep -q '/media/root-ro'; then
        die "This system does not appear to have an A/B installation (no squashfs root)"
    fi

    # Populate DETECTED_* (arch/platform/hostname/network) — the image build in
    # the upgrade needs them just like a fresh install does.
    detect_local_network

    # Preserve SSH host identity across the upgrade (handles dropbear<->openssh
    # transitions; for same-format, persist_host_keys reads live /etc/ssh anyway).
    if [ -z "$SSH_HOST_KEY_DIR" ]; then
        if capture_host_identity /tmp/aa-captured-keys; then
            SSH_HOST_KEY_DIR=/tmp/aa-captured-keys
        fi
    fi

    # Run upgrade (mounts the boot partition itself, derived from root=)
    run_upgrade "$ALPINE_VERSION"
}

# =============================================================================
# Local Mode: Live installation (existing)
# =============================================================================

run_local_installation() {
    # Require root for pivot_root
    if [ "$(id -u)" -ne 0 ]; then
        log_info "Escalating to root..."
        sudo_args="--local"
        [ "$VERBOSE" = "true" ] && sudo_args="$sudo_args -v"
        [ "$FORCE" = "true" ] && sudo_args="$sudo_args -f"
        [ -n "$ALPINE_VERSION" ] && sudo_args="$sudo_args -V $ALPINE_VERSION"
        [ -n "$ALPINE_MIRROR" ] && sudo_args="$sudo_args -m $ALPINE_MIRROR"
        [ "$HARDENED_MODE" = "true" ] && sudo_args="$sudo_args --hardened"
        exec sudo -E sh "$0" $sudo_args
    fi

    log_info "Running RAM-only live mode (pivot_root)"

    # Setup directories
    setup_install_dirs "$HOME"
    create_install_dirs

    # Step 1: Validations
    log_step "Step 1/5: System validation"
    validate_local_commands
    validate_local_system

    # Step 2: Network detection
    log_step "Step 2/5: Network detection"
    detect_local_network
    print_network_summary

    # Step 3: SSH keys
    log_step "Step 3/5: SSH key retrieval"
    local ssh_keys
    ssh_keys=$(get_local_authorized_keys)

    # Step 4: Generate config + download
    log_step "Step 4/5: Configuration & download"
    find_working_mirror_local
    generate_apkovl "$ssh_keys" > /dev/null
    download_minirootfs

    # Step 5: Pivot to Alpine in RAM
    log_step "Step 5/5: Pivot to Alpine (RAM-only)"
    setup_pivot_environment
    execute_pivot

    log_info "Pivot complete. Alpine Linux is running from RAM."
    log_info "Reconnect via: ssh root@${DETECTED_IP_ADDRESS}"
    log_info "Reboot to restore original system."
}

# =============================================================================
# Local Mode Helper Functions
# =============================================================================

# Validate local system
validate_local_system() {
    log_info "Validating local system..."

    # Check memory
    local mem_kb
    mem_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    local mem_mb=$((mem_kb / 1024))
    if [ "$mem_mb" -lt 512 ]; then
        die "Insufficient memory: ${mem_mb}MB (minimum: 512MB)"
    fi
    log_info "Memory: ${mem_mb}MB"

    # Check if running as root or can sudo
    if [ "$(id -u)" -ne 0 ]; then
        if ! sudo -n true 2>/dev/null; then
            log_info "Will need sudo password for privileged operations"
        fi
    fi
}

# Determine installation method locally
determine_install_method_local() {
    if [ "$INSTALL_METHOD" = "auto" ]; then
        log_info "Auto-detecting installation method..."

        # Check for kexec support
        local kexec_config=""
        if [ -f /proc/config.gz ]; then
            kexec_config=$(zcat /proc/config.gz 2>/dev/null | grep '^CONFIG_KEXEC=' || true)
        elif [ -f "/boot/config-$(uname -r)" ]; then
            kexec_config=$(grep '^CONFIG_KEXEC=' "/boot/config-$(uname -r)" 2>/dev/null || true)
        fi

        if [ "$kexec_config" = "CONFIG_KEXEC=y" ]; then
            INSTALL_METHOD="kexec"
            log_info "kexec available - using kexec method"
        else
            INSTALL_METHOD="takeover"
            log_info "kexec not available - using takeover method"
        fi
    fi

    log_info "Installation method: ${INSTALL_METHOD}"
}

# Get local authorized keys
get_local_authorized_keys() {
    local keys=""

    # Try current user
    if [ -f ~/.ssh/authorized_keys ]; then
        keys=$(cat ~/.ssh/authorized_keys)
    fi

    # Try root
    if [ -f /root/.ssh/authorized_keys ]; then
        local root_keys
        root_keys=$(cat /root/.ssh/authorized_keys 2>/dev/null || sudo cat /root/.ssh/authorized_keys 2>/dev/null || true)
        if [ -n "$root_keys" ]; then
            if [ -n "$keys" ]; then
                keys="${keys}
${root_keys}"
            else
                keys="$root_keys"
            fi
        fi
    fi

    # Remove duplicates
    keys=$(echo "$keys" | sort -u | grep -v '^$' || true)

    if [ -z "$keys" ]; then
        log_warn "No SSH authorized keys found!"
        if [ "$FORCE" != "true" ]; then
            die "No SSH keys found. You may lose access after reboot. Use --force to continue."
        fi
    else
        local key_count
        key_count=$(echo "$keys" | wc -l | tr -d ' ')
        log_info "Found $key_count SSH key(s)"
    fi

    echo "$keys"
}

# Find working mirror locally
find_working_mirror_local() {
    log_info "Testing Alpine mirror..."

    local test_url="${ALPINE_MIRROR}/v${ALPINE_VERSION}/releases/${DETECTED_ARCH}/"

    if http_check_url "$test_url"; then
        log_info "Mirror OK: ${ALPINE_MIRROR}"
    else
        log_warn "Primary mirror failed, trying fallbacks..."
        for mirror in $FALLBACK_MIRRORS; do
            test_url="${mirror}/v${ALPINE_VERSION}/releases/${DETECTED_ARCH}/"
            if http_check_url "$test_url"; then
                ALPINE_MIRROR="$mirror"
                log_info "Using fallback mirror: ${ALPINE_MIRROR}"
                return 0
            fi
        done
        die "No working Alpine mirror found"
    fi
}

# Download Alpine files locally
download_alpine_files_local() {
    log_info "Downloading Alpine files..."

    if [ "$DETECTED_PLATFORM" = "rpi" ]; then
        download_alpine_rpi_files_local
    else
        download_alpine_netboot_files_local
    fi
}

# Download netboot files locally
download_alpine_netboot_files_local() {
    local base_url="${ALPINE_MIRROR}/v${ALPINE_VERSION}/releases/${DETECTED_ARCH}/netboot"

    cache_download "${base_url}/vmlinuz-${KERNEL_FLAVOR}" "vmlinuz-${KERNEL_FLAVOR}"
    cache_download "${base_url}/initramfs-${KERNEL_FLAVOR}" "initramfs-${KERNEL_FLAVOR}"
    cache_download "${base_url}/modloop-${KERNEL_FLAVOR}" "modloop-${KERNEL_FLAVOR}"

    # Create symlinks
    ln -sf "vmlinuz-${KERNEL_FLAVOR}" "${INSTALL_CACHE_DIR}/vmlinuz"
    ln -sf "initramfs-${KERNEL_FLAVOR}" "${INSTALL_CACHE_DIR}/initramfs"
    ln -sf "modloop-${KERNEL_FLAVOR}" "${INSTALL_CACHE_DIR}/modloop"
}

# Download RPi files locally
download_alpine_rpi_files_local() {
    local releases_url="${ALPINE_MIRROR}/v${ALPINE_VERSION}/releases/${DETECTED_ARCH}"
    local tarball_name

    # Find tarball name
    tarball_name=$(http_fetch_stdout "${releases_url}/" 2>/dev/null | grep -oE 'alpine-rpi-[0-9.]+-aarch64\.tar\.gz' | head -1)
    if [ -z "$tarball_name" ]; then
        tarball_name="alpine-rpi-${ALPINE_VERSION}.0-aarch64.tar.gz"
    fi

    # Download tarball
    cache_download "${releases_url}/${tarball_name}" "$tarball_name"

    # Extract kernel files
    local kernel_suffix="rpi"
    { [ "$DETECTED_RPI_VERSION" = "4" ] || [ "$DETECTED_RPI_VERSION" = "5" ]; } && kernel_suffix="rpi4"

    log_info "Extracting kernel files..."
    tar -xzf "${INSTALL_CACHE_DIR}/${tarball_name}" -C "${INSTALL_CACHE_DIR}" ./boot/

    # Copy kernel files
    if [ -f "${INSTALL_CACHE_DIR}/boot/vmlinuz-${kernel_suffix}" ]; then
        cp "${INSTALL_CACHE_DIR}/boot/vmlinuz-${kernel_suffix}" "${INSTALL_CACHE_DIR}/vmlinuz"
        cp "${INSTALL_CACHE_DIR}/boot/initramfs-${kernel_suffix}" "${INSTALL_CACHE_DIR}/initramfs"
        cp "${INSTALL_CACHE_DIR}/boot/modloop-${kernel_suffix}" "${INSTALL_CACHE_DIR}/modloop"
    else
        cp "${INSTALL_CACHE_DIR}/boot/vmlinuz-rpi" "${INSTALL_CACHE_DIR}/vmlinuz"
        cp "${INSTALL_CACHE_DIR}/boot/initramfs-rpi" "${INSTALL_CACHE_DIR}/initramfs"
        cp "${INSTALL_CACHE_DIR}/boot/modloop-rpi" "${INSTALL_CACHE_DIR}/modloop"
    fi

    # Cleanup
    rm -rf "${INSTALL_CACHE_DIR}/boot"
}

# Setup takeover locally
setup_takeover_local() {
    local apkovl_file="$1"

    log_info "Setting up takeover environment..."

    # Download minirootfs
    local minirootfs_url="${ALPINE_MIRROR}/v${ALPINE_VERSION}/releases/${DETECTED_ARCH}/alpine-minirootfs-${ALPINE_VERSION}.0-${DETECTED_ARCH}.tar.gz"
    cache_download "$minirootfs_url" "minirootfs.tar.gz"

    # Copy apkovl to cache
    cp "$apkovl_file" "${INSTALL_CACHE_DIR}/"

    # Generate setup script
    generate_takeover_setup_script "$apkovl_file"

    log_info "Takeover setup complete"
    log_info "Run: sudo ${INSTALL_BASE_DIR}/takeover-setup.sh"
}

# Generate takeover setup script
generate_takeover_setup_script() {
    local apkovl_file="$1"
    local apkovl_name
    apkovl_name=$(basename "$apkovl_file")

    local network_interfaces
    if [ "$NETWORK_IS_DHCP" = "true" ]; then
        network_interfaces="auto lo
iface lo inet loopback

auto ${DETECTED_INTERFACE}
iface ${DETECTED_INTERFACE} inet dhcp"
    else
        network_interfaces="auto lo
iface lo inet loopback

auto ${DETECTED_INTERFACE}
iface ${DETECTED_INTERFACE} inet static
    address ${DETECTED_IP_ADDRESS}
    netmask ${DETECTED_NETMASK}
    gateway ${DETECTED_GATEWAY}"
    fi

    # SSH package and configuration based on mode
    local ssh_package ssh_keygen ssh_config ssh_service
    if [ "$HARDENED_MODE" = "true" ]; then
        ssh_package="dropbear dropbear-openrc"
        ssh_keygen='mkdir -p ${TAKEOVER_DIR}/etc/dropbear
chroot ${TAKEOVER_DIR} /usr/bin/dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key 2>/dev/null || true'
        ssh_config="# Dropbear configured via command line options"
        ssh_service="dropbear"
    else
        ssh_package="openssh-server"
        ssh_keygen='chroot ${TAKEOVER_DIR} /usr/bin/ssh-keygen -A'
        ssh_config='cat > ${TAKEOVER_DIR}/etc/ssh/sshd_config << '\''SSHDCONFIG'\''
PermitRootLogin prohibit-password
PubkeyAuthentication yes
PasswordAuthentication no
Subsystem sftp /usr/lib/ssh/sftp-server
SSHDCONFIG'
        ssh_service="sshd"
    fi

    cat > "${INSTALL_BASE_DIR}/takeover-setup.sh" << SETUPSCRIPT
#!/bin/sh
# Alpine Anywhere Takeover Setup Script
# Generated: $(date -Iseconds)
# Mode: $([ "$HARDENED_MODE" = "true" ] && echo "hardened (dropbear)" || echo "standard (openssh)")
# Run this with sudo to setup the takeover environment

set -e

TAKEOVER_DIR="/takeover"
CACHE_DIR="${INSTALL_CACHE_DIR}"
LOG="${INSTALL_LOG_DIR}/takeover-setup.log"

log() {
    echo "[\$(date '+%Y-%m-%d %H:%M:%S')] \$*" | tee -a "\$LOG"
}

log "=== Setting up takeover environment ==="

# Create and mount tmpfs
log "Creating tmpfs at \${TAKEOVER_DIR}..."
mkdir -p \${TAKEOVER_DIR}
mount -t tmpfs -o size=512M tmpfs \${TAKEOVER_DIR}

# Extract minirootfs
log "Extracting Alpine minirootfs..."
tar -xzf \${CACHE_DIR}/minirootfs.tar.gz -C \${TAKEOVER_DIR}

# Create old_root mount point
mkdir -p \${TAKEOVER_DIR}/old_root

# Copy resolv.conf
cp /etc/resolv.conf \${TAKEOVER_DIR}/etc/resolv.conf

# Setup APK repositories
log "Configuring APK repositories..."
cat > \${TAKEOVER_DIR}/etc/apk/repositories << 'APKREPOS'
${ALPINE_MIRROR}/v${ALPINE_VERSION}/main
${ALPINE_MIRROR}/v${ALPINE_VERSION}/community
APKREPOS

# Mount necessary filesystems for chroot
log "Mounting filesystems for chroot..."
mount --bind /dev \${TAKEOVER_DIR}/dev
mount --bind /proc \${TAKEOVER_DIR}/proc 2>/dev/null || mount -t proc proc \${TAKEOVER_DIR}/proc

# Install essential packages
log "Installing packages..."
chroot \${TAKEOVER_DIR} /sbin/apk update
chroot \${TAKEOVER_DIR} /sbin/apk add --no-cache ${ssh_package} openrc busybox-openrc

# Setup SSH
log "Configuring SSH..."
mkdir -p \${TAKEOVER_DIR}/root/.ssh
chmod 700 \${TAKEOVER_DIR}/root/.ssh
tar -xzf \${CACHE_DIR}/${apkovl_name} -C \${TAKEOVER_DIR} ./root/.ssh/authorized_keys 2>/dev/null || true
chown 0:0 \${TAKEOVER_DIR}/root/.ssh/authorized_keys 2>/dev/null || true
chmod 600 \${TAKEOVER_DIR}/root/.ssh/authorized_keys 2>/dev/null || true
${ssh_keygen}

# Unmount chroot filesystems
umount \${TAKEOVER_DIR}/proc 2>/dev/null || true
umount \${TAKEOVER_DIR}/dev 2>/dev/null || true

${ssh_config}

# Setup network
log "Configuring network..."
mkdir -p \${TAKEOVER_DIR}/etc/network
cat > \${TAKEOVER_DIR}/etc/network/interfaces << 'NETCONFIG'
${network_interfaces}
NETCONFIG

echo '${DETECTED_HOSTNAME}' > \${TAKEOVER_DIR}/etc/hostname

# Enable services
chroot \${TAKEOVER_DIR} /sbin/rc-update add networking boot 2>/dev/null || true
chroot \${TAKEOVER_DIR} /sbin/rc-update add ${ssh_service} default 2>/dev/null || true

log "=== Setup complete ==="
log "Run: sudo ${INSTALL_BASE_DIR}/takeover-execute.sh"
SETUPSCRIPT

    chmod +x "${INSTALL_BASE_DIR}/takeover-setup.sh"

    # Also generate the execute script
    generate_takeover_execute_script
}

# Generate takeover execute script
generate_takeover_execute_script() {
    local network_setup
    if [ "$NETWORK_IS_DHCP" = "true" ]; then
        network_setup="/sbin/udhcpc -i ${DETECTED_INTERFACE} -b 2>/dev/null || true"
    else
        network_setup="/sbin/ifconfig ${DETECTED_INTERFACE} ${DETECTED_IP_ADDRESS} netmask ${DETECTED_NETMASK} up 2>/dev/null || true
/sbin/route add default gw ${DETECTED_GATEWAY} 2>/dev/null || true"
    fi

    # SSH startup command based on mode
    local ssh_startup ssh_name
    if [ "$HARDENED_MODE" = "true" ]; then
        # dropbear: -s disable password auth, -g disable root password login, -p port
        ssh_startup='chroot ${TAKEOVER_DIR} /usr/sbin/dropbear -p 2222 -s -g'
        ssh_name="dropbear"
    else
        ssh_startup='chroot ${TAKEOVER_DIR} /bin/mkdir -p /run/sshd
chroot ${TAKEOVER_DIR} /usr/sbin/sshd -p 2222'
        ssh_name="openssh"
    fi

    cat > "${INSTALL_BASE_DIR}/takeover-execute.sh" << EXECSCRIPT
#!/bin/sh
# Alpine Anywhere Takeover Execute Script
# Generated: $(date -Iseconds)
# Mode: $([ "$HARDENED_MODE" = "true" ] && echo "hardened (dropbear)" || echo "standard (openssh)")
# Run this with sudo to start Alpine in chroot

set -e

TAKEOVER_DIR="/takeover"

log() {
    echo "[takeover] \$*"
}

log "=== Starting Alpine takeover ==="

# Sync filesystems
sync

# Mount virtual filesystems in chroot
log "Mounting virtual filesystems..."
mount -t proc proc \${TAKEOVER_DIR}/proc 2>/dev/null || true
mount -t sysfs sys \${TAKEOVER_DIR}/sys 2>/dev/null || true
mount --bind /dev \${TAKEOVER_DIR}/dev 2>/dev/null || true
mkdir -p \${TAKEOVER_DIR}/dev/pts 2>/dev/null || true
mount -t devpts devpts \${TAKEOVER_DIR}/dev/pts 2>/dev/null || true
mount --bind /run \${TAKEOVER_DIR}/run 2>/dev/null || mkdir -p \${TAKEOVER_DIR}/run

# Start Alpine services inside chroot
log "Starting Alpine networking..."
chroot \${TAKEOVER_DIR} /sbin/ifconfig lo 127.0.0.1 up
chroot \${TAKEOVER_DIR} /bin/sh -c '${network_setup}'

log "Starting Alpine SSH (${ssh_name}) on port 2222..."
${ssh_startup}

log "=== Takeover complete ==="
log "Alpine Linux SSH (${ssh_name}) running in chroot on port 2222"
log "Connect via: ssh -p 2222 root@${DETECTED_IP_ADDRESS}"
log ""
log "To fully enter the Alpine environment:"
log "  sudo chroot /takeover /bin/sh"
log ""
log "Host SSH remains on port 22."
EXECSCRIPT

    chmod +x "${INSTALL_BASE_DIR}/takeover-execute.sh"
}

# Setup kexec locally
setup_kexec_local() {
    local apkovl_file="$1"

    log_info "Setting up kexec..."

    # Copy apkovl to cache
    cp "$apkovl_file" "${INSTALL_CACHE_DIR}/"

    # Generate kexec script
    generate_kexec_script_local "$apkovl_file"

    log_info "Kexec setup complete"
    log_info "Run: sudo ${INSTALL_BASE_DIR}/kexec.sh"
}

# Generate kexec script locally
generate_kexec_script_local() {
    local apkovl_file="$1"
    local apkovl_name
    apkovl_name=$(basename "$apkovl_file")

    local cmdline="console=tty0 console=ttyS0,115200n8 "
    cmdline="${cmdline}alpine_repo=${ALPINE_MIRROR}/v${ALPINE_VERSION}/main "
    cmdline="${cmdline}modloop=${INSTALL_CACHE_DIR}/modloop "
    cmdline="${cmdline}modules=loop,squashfs,sd-mod,usb-storage "

    if [ "$NETWORK_IS_DHCP" = "true" ]; then
        cmdline="${cmdline}ip=dhcp "
    else
        cmdline="${cmdline}ip=${DETECTED_IP_ADDRESS}::${DETECTED_GATEWAY}:${DETECTED_NETMASK}:${DETECTED_HOSTNAME}:${DETECTED_INTERFACE}:off "
    fi

    cmdline="${cmdline}apkovl=${INSTALL_CACHE_DIR}/${apkovl_name}"

    cat > "${INSTALL_BASE_DIR}/kexec.sh" << KEXECSCRIPT
#!/bin/sh
# Alpine Anywhere Kexec Script
# Generated: $(date -Iseconds)

set -e

CACHE_DIR="${INSTALL_CACHE_DIR}"
LOG="${INSTALL_LOG_DIR}/kexec.log"

log() {
    echo "[\$(date '+%Y-%m-%d %H:%M:%S')] \$*" | tee -a "\$LOG"
}

log "=== Alpine Anywhere Kexec ==="

# Verify files
for f in vmlinuz initramfs modloop ${apkovl_name}; do
    if [ ! -f "\${CACHE_DIR}/\$f" ]; then
        log "ERROR: Missing \$f"
        exit 1
    fi
done

CMDLINE="${cmdline}"

if [ "\$1" = "--dry-run" ]; then
    log "[DRY-RUN] kexec -l \${CACHE_DIR}/vmlinuz --initrd=\${CACHE_DIR}/initramfs"
    log "[DRY-RUN] cmdline: \$CMDLINE"
    exit 0
fi

if [ "\$(id -u)" -ne 0 ]; then
    log "ERROR: Run with sudo"
    exit 1
fi

log "Loading kernel..."
kexec -l "\${CACHE_DIR}/vmlinuz" --initrd="\${CACHE_DIR}/initramfs" --command-line="\$CMDLINE"

log "Executing in 5 seconds..."
sleep 5
sync
exec kexec -e
KEXECSCRIPT

    chmod +x "${INSTALL_BASE_DIR}/kexec.sh"
}

# Execute takeover locally
execute_takeover_local() {
    if [ "$DRY_RUN" = "true" ]; then
        log_info "[DRY-RUN] Would execute takeover"
        log_info "[DRY-RUN] Scripts generated at ${INSTALL_BASE_DIR}/"
        return 0
    fi

    echo ""
    echo "===================================================="
    echo "Ready to takeover into Alpine Linux!"
    echo "===================================================="
    echo "Method:      takeover (pivot_root)"
    echo "IP Address:  ${DETECTED_IP_ADDRESS}"
    echo "Scripts at:  ${INSTALL_BASE_DIR}/"
    echo ""
    echo "To proceed:"
    echo "  1. sudo ${INSTALL_BASE_DIR}/takeover-setup.sh"
    echo "  2. sudo ${INSTALL_BASE_DIR}/takeover-execute.sh"
    echo "===================================================="

    confirm_action "Run takeover setup now?"

    log_info "Running takeover setup..."
    sudo "${INSTALL_BASE_DIR}/takeover-setup.sh"

    confirm_action "Run takeover execute now? (This will pivot to Alpine)"

    log_warn "Executing takeover..."
    sudo "${INSTALL_BASE_DIR}/takeover-execute.sh"
}

# Execute kexec locally
execute_kexec_local() {
    if [ "$DRY_RUN" = "true" ]; then
        log_info "[DRY-RUN] Would execute kexec"
        log_info "[DRY-RUN] Script at ${INSTALL_BASE_DIR}/kexec.sh"
        return 0
    fi

    echo ""
    echo "===================================================="
    echo "Ready to kexec into Alpine Linux!"
    echo "===================================================="
    echo "Method:      kexec"
    echo "IP Address:  ${DETECTED_IP_ADDRESS}"
    echo "Script at:   ${INSTALL_BASE_DIR}/kexec.sh"
    echo "===================================================="

    confirm_action "Execute kexec now? (This will reboot into Alpine)"

    log_warn "Executing kexec..."
    sudo "${INSTALL_BASE_DIR}/kexec.sh"
}

